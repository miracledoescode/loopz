# Firebase web config (safe to expose client-side)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# NOTE: the Gemini API key does NOT go here.
# It lives only in Cloud Functions config (see functions/README below),
# because Cloud Functions run server-side and the key must never ship
# inside the client app bundle.
